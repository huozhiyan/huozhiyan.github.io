---
interface Props {
  variant: 'film' | 'idphoto';
  class?: string;
}
const { variant, class: className } = Astro.props;
---

<div class:list={['cover', variant, className]} aria-hidden="true">
  {
    variant === 'film' ? (
      <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="filmBg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#1b1710" />
            <stop offset="55%" stop-color="#14120d" />
            <stop offset="100%" stop-color="#0d0b08" />
          </linearGradient>
          <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#e8460c" stop-opacity="0.30" />
            <stop offset="100%" stop-color="#e8460c" stop-opacity="0" />
          </linearGradient>
        </defs>

        <rect width="640" height="400" fill="url(#filmBg)" />
        <rect x="0" y="0" width="640" height="250" fill="url(#glow)" opacity="0.5" />

        <g opacity="0.14" stroke="#e8460c" stroke-width="1">
          {Array.from({ length: 16 }).map((_, i) => <line x1={i * 40 + 20} y1="0" x2={i * 40 + 20} y2="400" />)}
        </g>

        <text x="600" y="52" fill="#4a453c" text-anchor="end" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" letter-spacing="2">
          WASM / LOCAL
        </text>

        <g>
          <rect x="40" y="200" width="150" height="112" rx="3" fill="#23201a" stroke="#332e26" />
          <rect x="196" y="200" width="190" height="112" rx="3" fill="#2a2620" stroke="#3a342b" />
          <rect x="392" y="200" width="118" height="112" rx="3" fill="#23201a" stroke="#332e26" />
          <rect x="516" y="200" width="84" height="112" rx="3" fill="#1c1914" stroke="#2b2721" />

          <rect x="196" y="200" width="190" height="112" fill="#e8460c" opacity="0.08" />

          <line x1="40" y1="256" x2="600" y2="256" stroke="#4a4438" stroke-width="1" stroke-dasharray="2 4" />

          <g fill="#6a6357" font-family="ui-monospace, Menlo, monospace" font-size="9">
            <text x="40" y="334">00:00</text>
            <text x="330" y="334">01:24</text>
            <text x="600" y="334" text-anchor="end">02:11</text>
          </g>

          <g stroke="#e8460c" stroke-width="1.5">
            <line x1="330" y1="188" x2="330" y2="324" />
          </g>
          <circle cx="330" cy="188" r="4.5" fill="#e8460c" />

          <g fill="#e8460c">
            <rect x="196" y="196" width="4" height="120" rx="1" />
            <rect x="382" y="196" width="4" height="120" rx="1" />
          </g>
        </g>

        <g fill="#5c5548" font-family="ui-monospace, Menlo, monospace" font-size="9" letter-spacing="1.5">
          <text x="40" y="368">MP4 → WEBM</text>
          <text x="600" y="368" text-anchor="end">NO UPLOAD</text>
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="idBg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#eef2f8" />
            <stop offset="100%" stop-color="#dde5f0" />
          </linearGradient>
          <linearGradient id="photoBg" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3d6fb8" />
            <stop offset="100%" stop-color="#28518f" />
          </linearGradient>
        </defs>

        <rect width="640" height="400" fill="url(#idBg)" />

        <g opacity="0.55" stroke="#c3d0e2" stroke-width="1">
          {Array.from({ length: 13 }).map((_, i) => <line x1="0" y1={i * 32 + 16} x2="640" y2={i * 32 + 16} />)}
        </g>

        <text x="592" y="54" fill="#9aabc2" text-anchor="end" font-family="ui-monospace, Menlo, monospace" font-size="10" letter-spacing="2">
          ON-DEVICE AI
        </text>

        <!-- 原图：虚线框 -->
        <g>
          <rect x="86" y="140" width="180" height="234" rx="2" fill="#ffffff" fill-opacity="0.55" stroke="#9fb1c9" stroke-width="1.5" stroke-dasharray="6 5" />
          <g fill="#b9c7d9">
            <circle cx="176" cy="228" r="30" />
            <path d="M116 372c0-33 27-60 60-60s60 27 60 60Z" />
          </g>
          <text x="176" y="404" fill="#8fa1b8" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="9" letter-spacing="1.5">
            原图
          </text>
        </g>

        <g stroke="#7d95b3" stroke-width="1.5" fill="none" stroke-linecap="round">
          <path d="M296 256h56M344 248l10 8-10 8" />
        </g>

        <!-- 成品照 -->
        <g>
          <rect x="372" y="128" width="196" height="256" rx="2" fill="#ffffff" stroke="#c2cfdf" />
          <rect x="380" y="136" width="180" height="240" fill="url(#photoBg)" />
          <g fill="#e8eef7" opacity="0.92">
            <circle cx="470" cy="226" r="34" />
            <path d="M404 376c0-37 30-66 66-66s66 29 66 66Z" />
          </g>
          <g stroke="#7f97b5" stroke-width="1.5" fill="none">
            <path d="M372 148v-20h20M548 128h20v20M568 364v20h-20M392 384h-20v-20" opacity="0.6" />
          </g>
          <text x="470" y="404" fill="#7d92ad" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="9" letter-spacing="1.5">
            35 × 49 MM · 白底
          </text>
        </g>
      </svg>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }

  .cover svg {
    width: 100%;
    height: 100%;
  }
</style>
