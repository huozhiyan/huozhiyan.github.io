---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404" description="页面不存在。" noindex>
  <Header />
  <main id="main" class="wrap notfound">
    <p class="mono code">404 / NOT FOUND</p>
    <h1 class="display big">这个页面<br />还没被做出来。</h1>
    <p class="lede">链接可能失效了，也可能是你手抖了。两边都不丢人。</p>
    <div class="row">
      <a class="btn" href={`${base}/`}>回首页</a>
      <a class="btn ghost" href={`${base}/#works`}>看作品</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    padding-block: clamp(72px, 14vw, 160px);
  }

  .code {
    color: var(--accent);
    margin: 0 0 24px;
  }

  .big {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    margin-bottom: 22px;
  }

  .row {
    display: flex;
    gap: 10px;
    margin-top: 36px;
  }
</style>
