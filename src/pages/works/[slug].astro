---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${import.meta.env.BASE_URL}${p.replace(/^\//, '')}`;
const { Content } = await render(work);
const d = work.data;

const siblings = (await getCollection('works'))
  .filter((w) => w.id !== work.id)
  .sort((a, b) => b.data.order - a.data.order);
const next = siblings[0];

const date = `${d.date.getFullYear()}.${String(d.date.getMonth() + 1).padStart(2, '0')}`;
---

<Base title={d.title} description={d.summary} ogType="article">
  <Header />

  <main id="main">
    <article class="wrap post">
      <a class="back mono" href={`${base}/#works`}>
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path
            d="M13 8H3M7 4 3 8l4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        全部作品
      </a>

      <header class="post-head">
        <div class="meta-row mono">
          <span class="status"><span class="dot"></span>{d.status}</span>
          <span class="sep">/</span>
          <span>{date}</span>
          {
            d.latin && (
              <>
                <span class="sep">/</span>
                <span>{d.latin}</span>
              </>
            )
          }
        </div>

        <h1 class="display post-title">{d.title}</h1>
        <p class="post-tagline">{d.tagline}</p>

        <div class="actions">
          {
            d.live && (
              <a class="btn" href={d.live} target="_blank" rel="noopener noreferrer">
                打开作品
                <svg class="arrow" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path
                    d="M5 11 11 5M6 5h5v5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )
          }
          {
            d.repo && (
              <a class="btn ghost" href={d.repo} target="_blank" rel="noopener noreferrer">
                源码
                <svg class="arrow" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path
                    d="M5 11 11 5M6 5h5v5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )
          }
        </div>
      </header>

      <div class="factbar">
        <div class="fact">
          <span class="mono">技术栈</span>
          <p>{d.stack.join(' · ')}</p>
        </div>
        <div class="fact">
          <span class="mono">分类</span>
          <p>{d.tags.join(' · ')}</p>
        </div>
        <div class="fact">
          <span class="mono">运行方式</span>
          <p>浏览器本地</p>
        </div>
      </div>

      {
        d.screenshot && (
          <figure class="shot">
            <div class="shot-frame">
              <div class="shot-bar">
                <span class="dot-set" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
                <span class="url mono">{d.live?.replace(/^https?:\/\//, '')}</span>
              </div>
              <img src={asset(d.screenshot)} alt={`${d.title} 界面`} loading="lazy" width="1440" height="640" decoding="async" />
            </div>
            {d.screenshotNote && <figcaption class="mono">{d.screenshotNote}</figcaption>}
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <nav class="post-nav" aria-label="其他作品">
        <span class="mono nav-label">下一件</span>
        {
          next && (
            <a class="next-work" href={`${base}/works/${next.id}/`}>
              <span class="nw-title">{next.data.title}</span>
              <span class="nw-tagline">{next.data.tagline}</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )
        }
      </nav>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .post {
    padding-block: clamp(28px, 5vw, 48px) clamp(56px, 9vw, 96px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    transition: color 0.16s ease;
  }

  .back:hover {
    color: var(--ink);
  }

  .post-head {
    margin-top: clamp(28px, 5vw, 44px);
    padding-bottom: clamp(28px, 4vw, 40px);
    border-bottom: 1px solid var(--line);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    flex-wrap: wrap;
  }

  .meta-row .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink);
  }

  .meta-row .sep {
    color: var(--line-strong);
  }

  .post-title {
    margin-top: 18px;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }

  .post-tagline {
    margin: 16px 0 0;
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    gap: 10px;
    margin-top: 26px;
    flex-wrap: wrap;
  }

  .factbar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-bottom: 1px solid var(--line);
  }

  .fact {
    padding: 18px 20px 18px 0;
    border-right: 1px solid var(--line);
  }

  .fact:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .fact span {
    color: var(--muted);
  }

  .fact p {
    margin: 8px 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .shot {
    margin: clamp(32px, 5vw, 48px) 0 0;
  }

  .shot-frame {
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-2);
  }

  .shot-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 60%, var(--paper-2));
  }

  .dot-set {
    display: flex;
    gap: 5px;
  }

  .dot-set i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .url {
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.02em;
    text-transform: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shot img {
    width: 100%;
    height: auto;
  }

  .shot figcaption {
    margin-top: 10px;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .prose {
    margin-top: clamp(36px, 6vw, 56px);
  }

  .post-nav {
    margin-top: clamp(56px, 8vw, 88px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .nav-label {
    color: var(--muted);
  }

  .next-work {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 16px;
    margin-top: 14px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper-2);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .next-work:hover {
    border-color: var(--line-strong);
    transform: translateX(3px);
  }

  .nw-title {
    grid-column: 1;
    grid-row: 1;
    font-size: 1.1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .nw-tagline {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .next-work svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .factbar {
      grid-template-columns: 1fr;
    }

    .fact {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-right: 0;
    }

    .fact:last-child {
      border-bottom: 0;
    }
  }
</style>
